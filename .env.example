# ─────────────────────────────────────────────────────────────
# Horizons CRM — variáveis de ambiente
# Copie para `.env` e ajuste os valores. Nunca versione o `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (usado pelo docker-compose)
POSTGRES_USER=horizons
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=horizons
POSTGRES_PORT=5432

# API
NODE_ENV=development
API_PORT=3333
DATABASE_URL=postgresql://horizons:troque-esta-senha@localhost:5432/horizons?schema=public
# Banco usado pelos testes de integração (é recriado a cada execução)
TEST_DATABASE_URL=postgresql://horizons:troque-esta-senha@localhost:5432/horizons_test?schema=public
# Origem do front-end (validação de Origin em requisições que alteram dados)
WEB_ORIGIN=http://localhost:3000
# Duração da sessão em horas
SESSION_TTL_HOURS=168
# Cookie com flag Secure (true em produção com HTTPS)
COOKIE_SECURE=false

# Senha das contas de demonstração criadas pelo seed
SEED_DEMO_PASSWORD=Demo@2026

# Web (Next.js) — endereço interno da API para o proxy /api/*
API_INTERNAL_URL=http://localhost:3333
